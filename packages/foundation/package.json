{
  "name": "@maneki/foundation",
  "version": "0.1.0",
  "description": "Design tokens and foundation styles for the Maneki design system",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./heroui-theme.js": {
      "import": "./dist/heroui-theme.js",
      "types": "./dist/heroui-theme.d.ts"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
