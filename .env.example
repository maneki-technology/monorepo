# DCTrading shared environment variables
# Copy to .env and fill in your values

# Alpaca Paper Trading (required for bot)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Trading pair (optional; default: BTC/USD)
# Alpaca uses slash form (BTC/USD); Binance feed maps USD quote to USDT (BTCUSDT)
# TRADING_SYMBOL=BTC/USD

# Turso Database (required for bot + app)
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy.sh Push Notifications (optional)
NTFY_TOPIC=

# Binance Host (default: binance.com, use binance.us for US)
# BINANCE_WS_HOST=stream.binance.com
# BINANCE_API_HOST=api.binance.com

# Alpha Vantage (optional, for Python sentiment lab)
# ALPHA_VANTAGE_API_KEY=

# Instance tracking
# BOT_INSTANCE=local

# Cloud deployment switch scripts (AWS Tokyo by default)
# CLOUD_TARGET=aws
# AWS_REGION=ap-northeast-1
# AWS_INSTANCE_ID=i-...
# AWS_SSH_USER=ec2-user
# AWS_SSH_KEY=~/.ssh/dctrading-aws.pem
# AWS_SSH_HOST=ec2-...ap-northeast-1.compute.amazonaws.com
# AWS_REMOTE_DIR=.
# AWS_SERVICE_NAME=dctrading

# Funding Rate Filter (optional, default: 0.0001 = 0.010%)
# Skip DC entries when 24h avg funding rate exceeds threshold
# FUNDING_SKIP_THRESHOLD=0.0001

# Checkpoint backups (optional, default: 5 local rotated backups)
# Set to 0 to disable backup rotation.
# CHECKPOINT_BACKUP_RETENTION=5
# Turso remote checkpoint backup interval in seconds (optional, default: 3600)
# Set to 0 to disable remote checkpoint backup.
# CHECKPOINT_REMOTE_BACKUP_INTERVAL=3600
